// This file is meant to be injected via `ttir.invoke_external`; the `.ext`
// extension suffix prevents it from being parsed directly by `llvm-lit`.
//
// It models an externally-compiled kernel: tensors have dynamic shapes and a
// placeholder `ttnn_layout` (1x1 grid) because the kernel is compiled without
// knowledge of the caller (graph) types. A helper kernel function is referenced
// by the `ttnn.generic` program attribute via a symbol reference (not a
// `func.call`), so it must survive inlining of the entry function.
#dram = #ttnn.buffer_type<dram>
#kernel_layout = #ttnn.ttnn_layout<(d0, d1) -> (d0, d1), <1x1>, memref<1x1x!ttcore.tile<32x32, f32>, #dram>, <interleaved>>
module {
  func.func @kernel(%in: tensor<?x?xf32, #kernel_layout>,
                    %out: tensor<?x?xf32, #kernel_layout>)
      -> tensor<?x?xf32, #kernel_layout> attributes {tt.function_type = "forward_device"} {
    "ttnn.generic"(%in, %out) <{
      program = #ttnn.program<
        kernels = [
          #ttnn.read_kernel<
            symbol_ref = @datamovement_kernel0,
            core_ranges = <[#ttnn.core_range<(0,0), (0,0)>]>,
            ct_args = [#ttnn.kernel_arg_cb_buffer_index<0>],
            common_rt_args = [],
            rt_args = []>
        ],
        cbs = [],
        semaphores = []>,
      operandSegmentSizes = array<i32: 2, 0>
    }> : (tensor<?x?xf32, #kernel_layout>, tensor<?x?xf32, #kernel_layout>) -> ()
    return %out : tensor<?x?xf32, #kernel_layout>
  }

  func.func private @datamovement_kernel0() attributes {
      tt.function_type = "kernel",
      ttkernel.arg_spec = #ttkernel.arg_spec< ct_args = [<arg_type = cb_port, operand_index = 0>]>,
      ttkernel.thread = #ttkernel.thread<noc>} {
    return
  }
}
